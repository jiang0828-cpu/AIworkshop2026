{
  "name": "ai-workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "daily:worker": "node --env-file=.env --import tsx scripts/daily-scheduler.ts",
    "db:migrate:daily-assets": "node --env-file=.env --import tsx scripts/migrate-daily-assets.ts",
    "daily:worker:tasks": "node --env-file=.env --import tsx scripts/daily-scheduler.ts --daily-only",
    "daily:worker:manual": "node --env-file=.env --import tsx scripts/daily-scheduler.ts --manual-news",
    "db:migrate:daily-orchestration": "node --env-file=.env --import tsx scripts/migrate-daily-orchestration.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "node scripts/init-db.cjs",
    "db:migrate:strategy": "node scripts/migrate-five-modules.mjs",
    "db:migrate:self": "node scripts/migrate-self-loop.mjs",
    "db:migrate:scenes": "node scripts/migrate-six-scenes.mjs",
    "db:migrate:research": "node scripts/migrate-research.mjs",
    "db:migrate:radar": "node --env-file=.env --import tsx scripts/migrate-radar.ts",
    "db:migrate:execution": "node --env-file=.env --import tsx scripts/migrate-execution-plan.ts",
    "db:migrate:hierarchy": "node scripts/migrate-execution-hierarchy.mjs",
    "db:migrate:delivery": "node scripts/migrate-delivery-codes.mjs",
    "db:migrate:task-recurrence": "node scripts/migrate-task-recurrence.mjs",
    "db:migrate:system-scene": "node scripts/migrate-system-scene.mjs",
    "db:push": "prisma db push",
    "db:generate-model-metadata": "node scripts/generate-prisma-models.cjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "cf:build": "prisma generate --generator cloudflareClient && node scripts/generate-prisma-models.cjs && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/prepare-worker-deploy.mjs && opennextjs-cloudflare deploy",
    "cf:d1:migrate": "wrangler d1 migrations apply ai-workbench-data --remote",
    "cf:daily:check": "prisma generate --generator cloudflareClient && wrangler deploy --config cloudflare/daily-wrangler.jsonc --dry-run --outdir .wrangler/daily-build",
    "cf:daily:deploy": "wrangler deploy --config cloudflare/daily-wrangler.jsonc",
    "cf:sync:check": "wrangler deploy --config cloudflare/sync-wrangler.jsonc --dry-run",
    "cf:sync:deploy": "wrangler deploy --config cloudflare/sync-wrangler.jsonc"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.19.0",
    "@prisma/client": "^6.14.0",
    "docx": "^9.14.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@eslint/eslintrc": "^3.3.1",
    "@opennextjs/cloudflare": "^1.20.4",
    "@playwright/test": "^1.55.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.3",
    "prisma": "^6.14.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
